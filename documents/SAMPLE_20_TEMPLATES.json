{
  "templates": [
    {
      "name": "01 - Find All Factors (MCQ)",
      "concept_id": "math.class5.factors_multiples.factors",
      "question_type": "MCQ",
      "question_pattern": "Find all the factors of {{number}}.",
      "variables": {
        "base": {
          "number": {
            "type": "integer",
            "enum": [24, 36, 48, 60, 72, 84, 90, 96]
          }
        },
        "computed": {
          "factors_list": { "formula": "factors(number)" },
          "multiples_list": { "formula": "multiples(number, 4)" },
          "trivial_factors": { "formula": "[1, number]" }
        },
        "constraints": []
      },
      "options": [
        {
          "pattern": "{{factors_list}}",
          "is_correct": true
        },
        {
          "pattern": "{{trivial_factors}}",
          "is_correct": false,
          "misconception_id": "ONLY_TRIVIAL_FACTORS",
          "student_thinking": "Only listed 1 and the number itself"
        },
        {
          "pattern": "{{multiples_list}}",
          "is_correct": false,
          "misconception_id": "FACTORS_VS_MULTIPLES",
          "student_thinking": "Confused factors with multiples"
        },
        {
          "pattern": "{{factors_list[1:-1]}}",
          "is_correct": false,
          "misconception_id": "MISSING_ENDPOINTS",
          "student_thinking": "Forgot 1 and the number itself"
        }
      ],
      "difficulty": 2,
      "solution": {
        "steps": [
          { "number": 1, "text": "To find factors, we need numbers that divide {{number}} evenly." },
          { "number": 2, "text": "Test each number from 1 to {{number}}." },
          { "number": 3, "text": "The factors of {{number}} are: {{factors_list}}" },
          { "number": 4, "text": "Total: {{len(factors_list)}} factors" }
        ]
      },
      "hints": [
        "A factor divides the number with no remainder",
        "Always include 1 and the number itself",
        "Check divisibility for each number from 2 onwards"
      ],
      "tags": ["factors", "find-factors", "basic"],
      "source": "FILE_IMPORT"
    },

    {
      "name": "02 - Find First N Multiples (MCQ)",
      "concept_id": "math.class5.factors_multiples.multiples",
      "question_type": "MCQ",
      "question_pattern": "Write the first 5 multiples of {{number}}.",
      "variables": {
        "base": {
          "number": {
            "type": "integer",
            "enum": [7, 8, 9, 11, 12, 13, 14, 15]
          }
        },
        "computed": {
          "multiples_5": { "formula": "multiples(number, 5)" },
          "factors_list": { "formula": "factors(number)" },
          "wrong_start": { "formula": "[0] + multiples(number, 4)" },
          "skip_multiples": { "formula": "[number * i for i in [1, 3, 5, 7, 9]]" }
        },
        "constraints": []
      },
      "options": [
        {
          "pattern": "{{multiples_5}}",
          "is_correct": true
        },
        {
          "pattern": "{{factors_list}}",
          "is_correct": false,
          "misconception_id": "MULTIPLES_VS_FACTORS",
          "student_thinking": "Confused multiples with factors"
        },
        {
          "pattern": "{{wrong_start}}",
          "is_correct": false,
          "misconception_id": "STARTING_FROM_ZERO",
          "student_thinking": "Started with 0 instead of the number itself"
        },
        {
          "pattern": "{{skip_multiples}}",
          "is_correct": false,
          "misconception_id": "SKIPPING_MULTIPLES",
          "student_thinking": "Skipped some multiples"
        }
      ],
      "difficulty": 2,
      "solution": {
        "steps": [
          { "number": 1, "text": "Multiples are obtained by multiplying {{number}} by 1, 2, 3, 4, 5..." },
          { "number": 2, "text": "{{number}} × 1 = {{number}}" },
          { "number": 3, "text": "{{number}} × 2 = {{number * 2}}" },
          { "number": 4, "text": "{{number}} × 3 = {{number * 3}}" },
          { "number": 5, "text": "First 5 multiples: {{multiples_5}}" }
        ]
      },
      "hints": [
        "Multiple = number × 1, number × 2, number × 3...",
        "The first multiple is the number itself",
        "Multiples keep increasing, factors stay within the number"
      ],
      "tags": ["multiples", "find-multiples", "basic"],
      "source": "FILE_IMPORT"
    },

    {
      "name": "03 - HCF of Two Numbers (MCQ)",
      "concept_id": "math.class5.factors_multiples.gcd",
      "question_type": "MCQ",
      "question_pattern": "Find the HCF (Highest Common Factor) of {{a}} and {{b}}.",
      "variables": {
        "base": {
          "a": {
            "type": "integer",
            "enum": [24, 36, 48, 60, 72]
          },
          "b": {
            "type": "integer",
            "enum": [18, 30, 42, 54, 66]
          }
        },
        "computed": {
          "hcf_result": { "formula": "gcd(a, b)" },
          "lcm_result": { "formula": "lcm(a, b)" },
          "product": { "formula": "a * b" },
          "sum": { "formula": "a + b" }
        },
        "constraints": ["a != b"]
      },
      "options": [
        {
          "pattern": "{{hcf_result}}",
          "is_correct": true
        },
        {
          "pattern": "{{lcm_result}}",
          "is_correct": false,
          "misconception_id": "HCF_LCM_CONFUSION",
          "student_thinking": "Confused HCF with LCM"
        },
        {
          "pattern": "{{min(a, b)}}",
          "is_correct": false,
          "misconception_id": "SMALLEST_NUMBER",
          "student_thinking": "Thought HCF is the smaller number"
        },
        {
          "pattern": "1",
          "is_correct": false,
          "misconception_id": "ALWAYS_ONE",
          "student_thinking": "Thought 1 is always the HCF"
        }
      ],
      "difficulty": 3,
      "solution": {
        "steps": [
          { "number": 1, "text": "Find factors of {{a}}: {{factors(a)}}" },
          { "number": 2, "text": "Find factors of {{b}}: {{factors(b)}}" },
          { "number": 3, "text": "Common factors: {{common_factors(a, b)}}" },
          { "number": 4, "text": "HCF = Highest of common factors = {{hcf_result}}" }
        ]
      },
      "hints": [
        "List all factors of both numbers first",
        "Find which factors appear in BOTH lists",
        "HCF is the LARGEST common factor"
      ],
      "diagram": {
        "type": "gcd",
        "parameters": {
          "num1": "{{a}}",
          "num2": "{{b}}",
          "result": "{{hcf_result}}"
        }
      },
      "tags": ["hcf", "gcd", "common-factors"],
      "source": "FILE_IMPORT"
    },

    {
      "name": "04 - LCM of Two Numbers (MCQ)",
      "concept_id": "math.class5.factors_multiples.lcm",
      "question_type": "MCQ",
      "question_pattern": "Find the LCM (Lowest Common Multiple) of {{a}} and {{b}}.",
      "variables": {
        "base": {
          "a": {
            "type": "integer",
            "enum": [4, 6, 8, 10, 12]
          },
          "b": {
            "type": "integer",
            "enum": [5, 7, 9, 11, 15]
          }
        },
        "computed": {
          "lcm_result": { "formula": "lcm(a, b)" },
          "hcf_result": { "formula": "gcd(a, b)" },
          "product": { "formula": "a * b" },
          "sum": { "formula": "a + b" }
        },
        "constraints": ["a != b"]
      },
      "options": [
        {
          "pattern": "{{lcm_result}}",
          "is_correct": true
        },
        {
          "pattern": "{{product}}",
          "is_correct": false,
          "misconception_id": "LCM_IS_PRODUCT",
          "student_thinking": "Thought LCM is always the product"
        },
        {
          "pattern": "{{hcf_result}}",
          "is_correct": false,
          "misconception_id": "LCM_HCF_CONFUSION",
          "student_thinking": "Confused LCM with HCF"
        },
        {
          "pattern": "{{max(a, b)}}",
          "is_correct": false,
          "misconception_id": "LARGER_NUMBER",
          "student_thinking": "Thought LCM is the larger number"
        }
      ],
      "difficulty": 3,
      "solution": {
        "steps": [
          { "number": 1, "text": "List multiples of {{a}}: {{multiples(a, 10)}}" },
          { "number": 2, "text": "List multiples of {{b}}: {{multiples(b, 10)}}" },
          { "number": 3, "text": "Find the smallest number in both lists" },
          { "number": 4, "text": "LCM = {{lcm_result}}" }
        ]
      },
      "hints": [
        "List multiples of both numbers",
        "Find the SMALLEST number that appears in BOTH lists",
        "LCM is always ≥ the larger of the two numbers"
      ],
      "diagram": {
        "type": "lcm",
        "parameters": {
          "num1": "{{a}}",
          "num2": "{{b}}",
          "result": "{{lcm_result}}"
        }
      },
      "tags": ["lcm", "common-multiples"],
      "source": "FILE_IMPORT"
    },

    {
      "name": "05 - Prime Number Identification (TRUE_FALSE)",
      "concept_id": "math.class5.factors_multiples.prime_composite",
      "question_type": "TRUE_FALSE",
      "question_pattern": "{{number}} is a prime number.",
      "variables": {
        "base": {
          "number": {
            "type": "integer",
            "enum": [11, 13, 17, 19, 21, 25, 27, 29, 33, 37, 39, 41]
          }
        },
        "computed": {
          "is_prime_result": { "formula": "is_prime(number)" },
          "factors_list": { "formula": "factors(number)" },
          "factor_count": { "formula": "len(factors(number))" }
        },
        "constraints": []
      },
      "options": [
        {
          "pattern": "True",
          "is_correct": "{{is_prime_result}}"
        },
        {
          "pattern": "False",
          "is_correct": "{{not is_prime_result}}"
        }
      ],
      "difficulty": 2,
      "solution": {
        "steps": [
          { "number": 1, "text": "A prime number has exactly 2 factors: 1 and itself" },
          { "number": 2, "text": "Factors of {{number}}: {{factors_list}}" },
          { "number": 3, "text": "Number of factors: {{factor_count}}" },
          { "number": 4, "text": "Since {{number}} has {{factor_count}} factors, it is {{'prime' if is_prime_result else 'NOT prime'}}" }
        ]
      },
      "hints": [
        "Prime numbers have exactly 2 factors",
        "Check if any number between 2 and √{{number}} divides it",
        "1 is NOT a prime number"
      ],
      "tags": ["prime", "identification", "true-false"],
      "source": "FILE_IMPORT"
    },

    {
      "name": "06 - Divisibility Rule Application (FILL_BLANK)",
      "concept_id": "math.class5.factors_multiples.divisibility",
      "question_type": "FILL_BLANK",
      "question_pattern": "A number is divisible by {{divisor}} if {{divisibility_rule(divisor)}}. Is {{number}} divisible by {{divisor}}? The answer is ____.",
      "variables": {
        "base": {
          "divisor": {
            "type": "integer",
            "enum": [2, 3, 4, 5, 6, 9, 10]
          },
          "number": {
            "type": "integer",
            "enum": [126, 234, 345, 450, 567, 678, 789, 891]
          }
        },
        "computed": {
          "is_divisible": { "formula": "number % divisor == 0" },
          "answer": { "formula": "'Yes' if number % divisor == 0 else 'No'" },
          "remainder": { "formula": "number % divisor" }
        },
        "constraints": []
      },
      "options": [
        {
          "pattern": "{{answer}}",
          "is_correct": true
        },
        {
          "pattern": "{{'No' if answer == 'Yes' else 'Yes'}}",
          "is_correct": false,
          "misconception_id": "RULE_MISAPPLICATION",
          "student_thinking": "Applied the divisibility rule incorrectly"
        },
        {
          "pattern": "Maybe",
          "is_correct": false,
          "misconception_id": "UNCERTAIN",
          "student_thinking": "Unsure about the rule"
        },
        {
          "pattern": "Cannot determine",
          "is_correct": false,
          "misconception_id": "RULE_UNKNOWN",
          "student_thinking": "Doesn't know the divisibility rule"
        }
      ],
      "difficulty": 2,
      "solution": {
        "steps": [
          { "number": 1, "text": "Divisibility rule for {{divisor}}: {{divisibility_rule(divisor)}}" },
          { "number": 2, "text": "Check if {{number}} follows this rule" },
          { "number": 3, "text": "{{number}} ÷ {{divisor}} = {{number // divisor}} remainder {{remainder}}" },
          { "number": 4, "text": "Answer: {{answer}}" }
        ]
      },
      "hints": [
        "Remember the specific rule for divisibility by {{divisor}}",
        "Apply the rule step by step",
        "A number is divisible if the remainder is 0"
      ],
      "tags": ["divisibility", "rules", "fill-blank"],
      "source": "FILE_IMPORT"
    },

    {
      "name": "07 - Co-prime Numbers (ASSERTION_REASON)",
      "concept_id": "math.class5.factors_multiples.gcd",
      "question_type": "ASSERTION_REASON",
      "question_pattern": "",
      "parts": [
        {
          "type": "assertion",
          "label": "A",
          "pattern": "{{a}} and {{b}} are co-prime numbers."
        },
        {
          "type": "reason",
          "label": "R",
          "pattern": "Two numbers are co-prime if their HCF is 1."
        }
      ],
      "variables": {
        "base": {
          "a": {
            "type": "integer",
            "enum": [8, 9, 14, 15, 16, 21, 25, 27]
          },
          "b": {
            "type": "integer",
            "enum": [9, 11, 13, 15, 17, 19, 22, 23]
          }
        },
        "computed": {
          "hcf_result": { "formula": "gcd(a, b)" },
          "is_coprime_result": { "formula": "gcd(a, b) == 1" },
          "assertion_true": { "formula": "gcd(a, b) == 1" },
          "reason_true": { "formula": "True" }
        },
        "constraints": ["a != b"]
      },
      "options": [
        {
          "pattern": "Both A and R are true, and R correctly explains A",
          "is_correct": "{{assertion_true and reason_true}}"
        },
        {
          "pattern": "Both A and R are true, but R does not explain A",
          "is_correct": false
        },
        {
          "pattern": "A is true but R is false",
          "is_correct": false
        },
        {
          "pattern": "A is false but R is true",
          "is_correct": "{{not assertion_true and reason_true}}"
        }
      ],
      "difficulty": 4,
      "solution": {
        "steps": [
          { "number": 1, "text": "HCF of {{a}} and {{b}} = {{hcf_result}}" },
          { "number": 2, "text": "Assertion: {{a}} and {{b}} are co-prime → {{'TRUE' if assertion_true else 'FALSE'}} (HCF {{'=' if hcf_result == 1 else '≠'}} 1)" },
          { "number": 3, "text": "Reason: Definition of co-prime is correct → TRUE" },
          { "number": 4, "text": "The reason correctly defines what makes numbers co-prime" }
        ]
      },
      "hints": [
        "First calculate the HCF of the two numbers",
        "Co-prime means HCF = 1",
        "The reason gives the definition of co-prime numbers"
      ],
      "tags": ["coprime", "hcf", "assertion-reason"],
      "source": "FILE_IMPORT"
    },

    {
      "name": "08 - Fruit Basket Problem (CASE_STUDY)",
      "concept_id": "math.class5.factors_multiples.word_problem",
      "question_type": "CASE_STUDY",
      "question_pattern": "",
      "parts": [
        {
          "type": "context",
          "pattern": "Meera has {{apples}} apples and {{oranges}} oranges. She wants to distribute them equally among children such that each child gets the same number of apples and the same number of oranges. No fruit should be left over."
        },
        {
          "type": "sub_question",
          "label": "i",
          "pattern": "What is the maximum number of children who can receive fruits?",
          "options": [
            { "pattern": "{{gcd(apples, oranges)}}", "is_correct": true },
            { "pattern": "{{lcm(apples, oranges)}}", "is_correct": false, "misconception_id": "USED_LCM" },
            { "pattern": "{{apples + oranges}}", "is_correct": false, "misconception_id": "ADDED_FRUITS" },
            { "pattern": "{{min(apples, oranges)}}", "is_correct": false, "misconception_id": "USED_SMALLER" }
          ]
        },
        {
          "type": "sub_question",
          "label": "ii",
          "pattern": "How many apples will each child get?",
          "options": [
            { "pattern": "{{apples // gcd(apples, oranges)}}", "is_correct": true },
            { "pattern": "{{apples}}", "is_correct": false },
            { "pattern": "{{gcd(apples, oranges)}}", "is_correct": false },
            { "pattern": "{{oranges // gcd(apples, oranges)}}", "is_correct": false }
          ]
        },
        {
          "type": "sub_question",
          "label": "iii",
          "pattern": "How many oranges will each child get?",
          "options": [
            { "pattern": "{{oranges // gcd(apples, oranges)}}", "is_correct": true },
            { "pattern": "{{oranges}}", "is_correct": false },
            { "pattern": "{{gcd(apples, oranges)}}", "is_correct": false },
            { "pattern": "{{apples // gcd(apples, oranges)}}", "is_correct": false }
          ]
        }
      ],
      "variables": {
        "base": {
          "apples": {
            "type": "integer",
            "enum": [24, 36, 48, 60, 72]
          },
          "oranges": {
            "type": "integer",
            "enum": [18, 30, 42, 54, 66]
          }
        },
        "computed": {
          "max_children": { "formula": "gcd(apples, oranges)" },
          "apples_each": { "formula": "apples // gcd(apples, oranges)" },
          "oranges_each": { "formula": "oranges // gcd(apples, oranges)" }
        },
        "constraints": ["apples != oranges"]
      },
      "options": [
        { "pattern": "See sub-questions", "is_correct": true },
        { "pattern": "N/A", "is_correct": false }
      ],
      "difficulty": 4,
      "solution": {
        "steps": [
          { "number": 1, "text": "This is an HCF problem because we need equal distribution with no leftovers" },
          { "number": 2, "text": "HCF of {{apples}} and {{oranges}} = {{max_children}}" },
          { "number": 3, "text": "Maximum children = {{max_children}}" },
          { "number": 4, "text": "Apples per child = {{apples}} ÷ {{max_children}} = {{apples_each}}" },
          { "number": 5, "text": "Oranges per child = {{oranges}} ÷ {{max_children}} = {{oranges_each}}" }
        ]
      },
      "hints": [
        "Equal distribution without leftovers → use HCF",
        "HCF tells us the maximum number of groups possible",
        "Divide total fruits by HCF to get per-child count"
      ],
      "tags": ["hcf", "word-problem", "case-study", "distribution"],
      "source": "FILE_IMPORT"
    },

    {
      "name": "09 - Bus Timing Problem (CASE_STUDY)",
      "concept_id": "math.class5.factors_multiples.word_problem",
      "question_type": "CASE_STUDY",
      "question_pattern": "",
      "parts": [
        {
          "type": "context",
          "pattern": "Three buses start from the same bus station at 8:00 AM. Bus A returns every {{interval_a}} minutes, Bus B returns every {{interval_b}} minutes, and Bus C returns every {{interval_c}} minutes."
        },
        {
          "type": "sub_question",
          "label": "i",
          "pattern": "After how many minutes will all three buses return together for the first time?",
          "options": [
            { "pattern": "{{lcm_three(interval_a, interval_b, interval_c)}}", "is_correct": true },
            { "pattern": "{{gcd_three(interval_a, interval_b, interval_c)}}", "is_correct": false, "misconception_id": "USED_HCF" },
            { "pattern": "{{interval_a + interval_b + interval_c}}", "is_correct": false, "misconception_id": "ADDED_INTERVALS" },
            { "pattern": "{{interval_a * interval_b * interval_c}}", "is_correct": false, "misconception_id": "MULTIPLIED_ALL" }
          ]
        },
        {
          "type": "sub_question",
          "label": "ii",
          "pattern": "At what time will they meet for the first time?",
          "options": [
            { "pattern": "{{8 + lcm_three(interval_a, interval_b, interval_c) // 60}}:{{lcm_three(interval_a, interval_b, interval_c) % 60 if lcm_three(interval_a, interval_b, interval_c) % 60 > 9 else '0' + str(lcm_three(interval_a, interval_b, interval_c) % 60)}} AM", "is_correct": true },
            { "pattern": "9:00 AM", "is_correct": false },
            { "pattern": "10:00 AM", "is_correct": false },
            { "pattern": "8:30 AM", "is_correct": false }
          ]
        }
      ],
      "variables": {
        "base": {
          "interval_a": {
            "type": "integer",
            "enum": [10, 12, 15, 20]
          },
          "interval_b": {
            "type": "integer",
            "enum": [12, 15, 18, 20]
          },
          "interval_c": {
            "type": "integer",
            "enum": [15, 18, 20, 30]
          }
        },
        "computed": {
          "lcm_result": { "formula": "lcm_three(interval_a, interval_b, interval_c)" },
          "hours_later": { "formula": "lcm_three(interval_a, interval_b, interval_c) // 60" },
          "mins_later": { "formula": "lcm_three(interval_a, interval_b, interval_c) % 60" }
        },
        "constraints": [
          "interval_a != interval_b",
          "interval_b != interval_c",
          "interval_a != interval_c"
        ]
      },
      "options": [
        { "pattern": "See sub-questions", "is_correct": true },
        { "pattern": "N/A", "is_correct": false }
      ],
      "difficulty": 4,
      "solution": {
        "steps": [
          { "number": 1, "text": "To find when they meet again, we need the LCM of their intervals" },
          { "number": 2, "text": "LCM of {{interval_a}}, {{interval_b}}, {{interval_c}} = {{lcm_result}} minutes" },
          { "number": 3, "text": "{{lcm_result}} minutes = {{hours_later}} hour(s) and {{mins_later}} minute(s)" },
          { "number": 4, "text": "Starting at 8:00 AM + {{lcm_result}} minutes = meeting time" }
        ]
      },
      "hints": [
        "Finding when events coincide → use LCM",
        "LCM gives the smallest time when all intervals align",
        "Convert minutes to hours and minutes for the final time"
      ],
      "tags": ["lcm", "word-problem", "case-study", "time"],
      "source": "FILE_IMPORT"
    },

    {
      "name": "10 - Match Factors with Numbers (MATCH_FOLLOWING)",
      "concept_id": "math.class5.factors_multiples.factors",
      "question_type": "MATCH_FOLLOWING",
      "question_pattern": "Match the numbers in Column A with their number of factors in Column B.",
      "parts": [
        {
          "type": "context",
          "pattern": "Column A (Numbers) | Column B (Factor Count)\n1. {{num1}} | P. {{count3}}\n2. {{num2}} | Q. {{count1}}\n3. {{num3}} | R. {{count2}}"
        }
      ],
      "variables": {
        "base": {
          "num1": { "type": "integer", "enum": [12, 18, 20] },
          "num2": { "type": "integer", "enum": [15, 16, 24] },
          "num3": { "type": "integer", "enum": [25, 36, 49] }
        },
        "computed": {
          "count1": { "formula": "factor_count(num1)" },
          "count2": { "formula": "factor_count(num2)" },
          "count3": { "formula": "factor_count(num3)" }
        },
        "constraints": [
          "num1 != num2",
          "num2 != num3",
          "num1 != num3"
        ]
      },
      "options": [
        { "pattern": "1-Q, 2-R, 3-P", "is_correct": true },
