      "name": "17 - HCF × LCM = Product (ASSERTION_REASON)",
      "concept_id": "math.class5.factors_multiples.assertion_reason",
      "question_type": "ASSERTION_REASON",
      "question_pattern": "",
      "parts": [
        {
          "type": "assertion",
          "label": "A",
          "pattern": "For {{a}} and {{b}}, HCF × LCM = {{a}} × {{b}}"
        },
        {
          "type": "reason",
          "label": "R",
          "pattern": "For any two positive integers, HCF × LCM = Product of the numbers"
        }
      ],
      "variables": {
        "base": {
          "a": { "type": "integer", "enum": [12, 15, 18, 20, 24] },
          "b": { "type": "integer", "enum": [8, 10, 14, 16, 21] }
        },
        "computed": {
          "hcf_val": { "formula": "gcd(a, b)" },
          "lcm_val": { "formula": "lcm(a, b)" },
          "product": { "formula": "a * b" },
          "hcf_lcm_product": { "formula": "gcd(a, b) * lcm(a, b)" },
          "assertion_true": { "formula": "gcd(a, b) * lcm(a, b) == a * b" }
        },
        "constraints": ["a != b"]
      },
      "options": [
        {
          "pattern": "Both A and R are true, and R correctly explains A",
          "is_correct": true
        },
        {
          "pattern": "Both A and R are true, but R does not explain A",
          "is_correct": false
        },
        {
          "pattern": "A is true but R is false",
          "is_correct": false
        },
        {
          "pattern": "A is false but R is true",
          "is_correct": false
        }
      ],
      "difficulty": 4,
      "solution": {
        "steps": [
          { "number": 1, "text": "HCF of {{a}} and {{b}} = {{hcf_val}}" },
          { "number": 2, "text": "LCM of {{a}} and {{b}} = {{lcm_val}}" },
          { "number": 3, "text": "HCF × LCM = {{hcf_val}} × {{lcm_val}} = {{hcf_lcm_product}}" },
          { "number": 4, "text": "{{a}} × {{b}} = {{product}}" },
          { "number": 5, "text": "Both are equal! The formula HCF × LCM = a × b is always true." }
        ]
      },
      "hints": [
        "Calculate HCF and LCM separately",
        "Multiply HCF and LCM",
        "Compare with the product of the two numbers"
      ],
      "tags": ["hcf", "lcm", "relationship", "assertion-reason"],
      "source": "FILE_IMPORT"
